// YouTube Radar — schema completo da versão 1.
// Campos "platform" preparam o suporte futuro a TikTok (hoje sempre "youtube").
// Campos marcados como OAuth ficam vazios até a versão com login no YouTube.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Configuração e controle de cota ----------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Cada chamada à YouTube Data API registra o custo em unidades.
/// `quotaDay` é a data no fuso America/Los_Angeles (quando o Google zera a cota).
model QuotaLog {
  id        Int      @id @default(autoincrement())
  quotaDay  String
  endpoint  String
  units     Int
  /// Quem gastou: "coleta", "acompanhamento", o tipo da tarefa em segundo plano (ex.: "discover") ou null (outras ações).
  source    String?
  createdAt DateTime @default(now())

  @@index([quotaDay])
}

/// Histórico de coletas (automáticas ou manuais).
model CollectionRun {
  id         Int       @id @default(autoincrement())
  kind       String // "channels" | "videos" | "my_videos"
  trigger    String // "auto" | "manual" | "script"
  status     String    @default("running") // running | ok | error
  unitsUsed  Int       @default(0)
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ---------- Nichos e canais ----------

model Niche {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels    NicheChannel[]
  myChannels  MyChannel[]
  playbooks   NichePlaybook[]
  ideas       Idea[]
  discovered  DiscoveredChannel[]
  searches    DiscoverySearch[]
  studied     Video[]             @relation("StudyNiche")
  formats     VideoFormat[]
  rules       NicheRule[]
  suggestions FormatSuggestion[]
}

/// Canal de terceiros monitorado. Pode estar em vários nichos.
model Channel {
  id                String    @id @default(cuid())
  platform          String    @default("youtube")
  externalId        String // ID do canal na plataforma (UC...)
  title             String
  handle            String?
  description       String?
  thumbnailUrl      String?
  country           String?
  subscriberCount   Int?
  hiddenSubscribers Boolean   @default(false)
  videoCount        Int?
  viewCount         Float? // pode passar de 2^31
  uploadsPlaylistId String?
  channelCreatedAt  DateTime?
  statsFetchedAt    DateTime?
  videosFetchedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  catalogFetchedAt DateTime?

  niches    NicheChannel[]
  videos    Video[]
  snapshots ChannelSnapshot[]
  catalog   CatalogEntry[]

  @@unique([platform, externalId])
}

model NicheChannel {
  nicheId   String
  channelId String
  addedAt   DateTime @default(now())

  niche   Niche   @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([nicheId, channelId])
}

/// Catálogo completo de títulos de cada canal monitorado (todas as idades),
/// usado para conferir "esse tema já foi feito por um canal de referência?".
model CatalogEntry {
  id          Int      @id @default(autoincrement())
  channelId   String
  externalId  String // ID do vídeo
  title       String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@index([channelId])
}

model ChannelSnapshot {
  id              Int      @id @default(autoincrement())
  channelId       String
  day             String // YYYY-MM-DD (um por dia)
  subscriberCount Int?
  videoCount      Int?
  viewCount       Float?
  capturedAt      DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, day])
}

/// Canal meu (metadado). Status: PRODUCTION | VALIDATING | RESEARCH
model MyChannel {
  durationMinSec Int?
  durationMaxSec Int?
  id                String    @id @default(cuid())
  platform          String    @default("youtube")
  nicheId           String?
  name              String
  url               String?
  externalId        String?
  status            String    @default("RESEARCH")
  notes             String?
  // Preparado para OAuth (versão futura)
  oauthConnected    Boolean   @default(false)
  // Perfil do canal (etapa 6): o gerador adapta a cartilha a este formato.
  format            String    @default("short") // formato principal: "short" | "long"
  platforms         String? // ex.: "YouTube Shorts, TikTok"
  concept           String? // premissa / do que o canal trata
  characters        String? // personagens recorrentes (nome, idade, jeito, como fala)
  visualStyle       String? // estilo visual (ex.: animação 3D estilo Pixar, casa da família)
  tone              String? // tom e linguagem
  storyFormats      String? // formatos de história que se repetem (ex.: "menino fala algo errado e o pai corrige")
  audience          String? // público
  rules             String? // sempre / nunca
  examples          String? // roteiros aprovados colados pelo dono: exemplo de ritmo e humor no prompt (nunca copiar falas)
  durationSec       Int? // duração alvo
  catalogFetchedAt  DateTime? // última leitura da lista de vídeos do canal no YouTube
  analytics         String? // números do canal colados/importados (ex.: do YouTube Studio via Maestri)
  analyticsAt       DateTime?
  profileImportedAt DateTime? // último perfil importado de arquivo .md
  // Etapa 7: meus vídeos publicados
  title             String? // nome do canal no YouTube
  thumbnailUrl      String?
  subscriberCount   Int?
  uploadsPlaylistId String?
  syncedAt          DateTime? // última leitura da lista de uploads
  autoDiagnose      Boolean   @default(false) // diagnóstico automático em 24h, 3 dias e 7 dias
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  niche       Niche?            @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  videos      MyVideo[]
  ideas       Idea[]
  scripts     MyChannelScript[]
  reports     MyChannelReport[]
  catalog     MyChannelVideo[]
  formatNotes ChannelFormat[]
  lessons     ChannelLesson[]
}

/// Todos os vídeos que o meu canal já publicou (lidos do YouTube): o gerador não repete esses temas,
/// mesmo que o vídeo antigo tenha outro estilo (ex.: 2D).
model MyChannelVideo {
  id          String   @id @default(cuid())
  myChannelId String
  externalId  String
  title       String
  publishedAt DateTime
  durationSec Int?
  isShort     Boolean?
  viewCount   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  myChannel MyChannel @relation(fields: [myChannelId], references: [id], onDelete: Cascade)
  ideas     Idea[]

  @@unique([myChannelId, externalId])
  @@index([myChannelId, publishedAt])
}

/// Roteiros que o canal já publicou (ou escreveu): exemplos da voz e do formato do canal para o gerador.
model MyChannelScript {
  integrity String @default("unknown") // complete | truncated | unknown
  id          String   @id @default(cuid())
  myChannelId String
  title       String
  url         String?
  script      String
  views       Int?
  notes       String? // o que funcionou / o que não funcionou
  /// Formato (receita) que este roteiro segue: as amostras de voz do gerador saem primeiro dos roteiros do mesmo formato.
  formatId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  myChannel MyChannel    @relation(fields: [myChannelId], references: [id], onDelete: Cascade)
  format    VideoFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)

  @@index([myChannelId])
}

// ---------- Descoberta de canais (etapa 4) ----------

/// Cada busca de descoberta feita (para mostrar histórico e custo).
/// method: "search" (palavra-chave, 100 unidades) | "featured" (canais indicados pelos monitorados).
model DiscoverySearch {
  id          String   @id @default(cuid())
  nicheId     String
  method      String
  query       String?
  format      String // "short" | "long"
  params      String // JSON com os filtros usados
  unitsUsed   Int
  videosFound Int      @default(0)
  newChannels Int      @default(0)
  createdAt   DateTime @default(now())

  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([nicheId, createdAt])
}

/// Canal encontrado na descoberta, ainda não monitorado (por nicho).
/// status: "new" | "monitored" | "dismissed". Um canal ignorado não volta a aparecer como novo.
model DiscoveredChannel {
  id                String    @id @default(cuid())
  nicheId           String
  platform          String    @default("youtube")
  externalId        String
  title             String
  handle            String?
  thumbnailUrl      String?
  country           String?
  subscriberCount   Int?
  hiddenSubscribers Boolean   @default(false)
  videoCount        Int?
  viewCount         Float?
  channelCreatedAt  DateTime?
  // Vídeos do canal que apareceram nas buscas: JSON [{id, title, views, publishedAt, durationSec, isShort, thumb}]
  matchedVideos     String    @default("[]")
  shortHits         Int       @default(0)
  longHits          Int       @default(0)
  bestViews         Int       @default(0)
  bestRatio         Float? // melhor vídeo / inscritos
  score             Float     @default(0)
  queries           String    @default("[]") // JSON: palavras-chave que trouxeram o canal
  featuredBy        String    @default("[]") // JSON: canais monitorados que indicam este canal
  // Raio-x (últimos 50 uploads, 2 unidades): JSON calculado em código
  analysis          String?
  analyzedAt        DateTime?
  status            String    @default("new")
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())

  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@unique([nicheId, platform, externalId])
  @@index([nicheId, status])
}

// ---------- Vídeos monitorados ----------

model Video {
  id             String    @id @default(cuid())
  platform       String    @default("youtube")
  externalId     String
  channelId      String
  title          String
  description    String?
  tags           String? // JSON array
  thumbnailUrl   String?
  publishedAt    DateTime
  durationSec    Int?
  isShort        Boolean   @default(false)
  shortSource    String? // "duration" | "url" — como foi classificado
  viewCount      Int       @default(0)
  likeCount      Int?
  commentCount   Int?
  defaultLang    String?
  statsFetchedAt DateTime?
  // Nicho do estudo (etapa 5): para vídeo de canal fora dos nichos (estudado por link).
  // O vídeo entra na cartilha desse nicho além dos nichos do próprio canal.
  studyNicheId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  channel     Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  studyNiche  Niche?             @relation("StudyNiche", fields: [studyNicheId], references: [id], onDelete: SetNull)
  snapshots   VideoSnapshot[]
  favorite    Favorite?
  transcript  Transcript?
  diagnosis   Diagnosis?
  structure   ScriptStructure?
  inspired    MyVideo[]
  formats     FormatVideo[]
  suggestions FormatSuggestion[]

  @@unique([platform, externalId])
  @@index([channelId, publishedAt])
}

model VideoSnapshot {
  id           Int      @id @default(autoincrement())
  videoId      String
  day          String // YYYY-MM-DD
  viewCount    Int
  likeCount    Int?
  commentCount Int?
  capturedAt   DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, day])
}

model Favorite {
  id        String   @id @default(cuid())
  videoId   String   @unique
  note      String?
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

// ---------- Estudo ----------

/// Transcrição do vídeo. Uma por vídeo.
/// source: "youtube" (legendas buscadas pelo app) | "manual" (colada na tela) | "import" (estudo externo).
/// Importações externas (ex.: projeto Faro) preenchem importSource + importKey; o importKey é único,
/// então rodar a importação de novo atualiza em vez de duplicar.
model Transcript {
  id           String    @id @default(cuid())
  videoId      String    @unique
  language     String
  source       String // "youtube" | "manual" | "import"
  trackKind    String? // "manual" (legenda feita por gente) | "asr" (automática do YouTube)
  text         String
  segments     String? // JSON [{start, dur, text}] — segundos; vazio quando não há tempos
  wordCount    Int?
  importSource String? // ex.: "faro"
  importKey    String?   @unique // ex.: "faro:Olheiros/Canal X/transcricao-video.md"
  importedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

/// Diagnóstico do vídeo (uma linha por vídeo).
/// `metrics` é medido em código (nunca pelo Claude); `content` é a leitura do Claude (hipóteses).
/// source: "app" (gerado aqui) | "import" (estudo externo; nesse caso o texto pode vir só em `markdown`).
model Diagnosis {
  id                 String    @id @default(cuid())
  videoId            String    @unique
  source             String    @default("app") // "app" | "import"
  model              String?
  effort             String?
  content            String? // JSON estruturado (explicação = hipótese)
  metrics            String? // JSON medido: palavras/s, intervalo entre eventos, abertura, fecho, fórmula do título
  markdown           String? // versão em texto
  usedTranscript     Boolean   @default(false)
  inputTokens        Int?
  outputTokens       Int?
  costUsd            Float?
  diagnosedAt        DateTime?
  // Análise de comentários (feature 10)
  commentsRaw        String? // JSON [{author, text, likes, replies, publishedAt}] — os mais relevantes
  commentsFetchedAt  DateTime?
  commentsAnalysis   String? // JSON
  commentsModel      String?
  commentsCostUsd    Float?
  commentsAnalyzedAt DateTime?
  importSource       String?
  importKey          String?   @unique
  importedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

/// Esqueleto de roteiro extraído de um diagnóstico com transcrição.
model ScriptStructure {
  id              String   @id @default(cuid())
  videoId         String   @unique
  isShort         Boolean
  content         String // JSON {hook, turn, development, climax, close} com tempos
  beats           String? // JSON [{t, kind, text}] — cada "algo novo" com segundo exato
  wordsPerSec     Float?
  avgBeatInterval Float? // segundos médios entre eventos novos
  maxBeatGap      Float? // maior intervalo sem novidade
  durationSec     Int?
  source          String   @default("app") // "app" | "import"
  importKey       String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

/// Cartilha do nicho (etapa 5): uma versão por geração, separada por formato.
/// `stats` é medido em código a partir dos estudos; `content` é a síntese do Claude (hipóteses com base em N estudos).
model NichePlaybook {
  id             String   @id @default(cuid())
  nicheId        String
  format         String   @default("short") // "short" | "long"
  model          String
  stats          String // JSON calculado em código
  content        String // JSON do Claude
  markdown       String?
  diagnosisCount Int
  studyIds       String   @default("[]") // JSON: Video.id dos estudos usados
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Float?
  createdAt      DateTime @default(now())

  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([nicheId, createdAt])
  @@index([nicheId, format, createdAt])
}

// ---------- Formatos (camada 1) e regra geral do nicho (camada 2) ----------

/// Formato = uma receita de vídeo dentro de um nicho, tirada de 3 a 5 vídeos estudados que seguem a mesma estrutura
/// (ex.: "desastre em cadeia", "construir resolvendo problemas"). Com menos de 3 vídeos fica como rascunho.
/// `length` é Short ou vídeo longo (o antigo "formato" das cartilhas).
model VideoFormat {
  directionGeneral String?
  directionScene String?
  directionPhotography String?
  directionSound String?
  narrativeRules String?
  directionStudy String?
  id          String   @id @default(cuid())
  nicheId     String
  name        String
  description String?
  length      String   @default("short") // "short" | "long"
  // O que falta quando o formato tem menos de 3 vídeos: JSON GapHint (tipo de vídeo, palavras para procurar, candidatos do radar)
  gaps        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  niche       Niche              @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  suggestions FormatSuggestion[]
  videos      FormatVideo[]
  recipes     FormatRecipe[]
  ideas       Idea[]
  scripts     MyChannelScript[]
  channels    ChannelFormat[]
  lessons     ChannelLesson[]

  @@index([nicheId])
}

/// Sugestão automática de formato para um estudo (pela transcrição e pelo diagnóstico). Uma por vídeo e nicho.
/// `label` é o nome do formato sugerido ou "nenhum". status: pending (esperando eu) | confirmed (aceitei) | changed (troquei).
model FormatSuggestion {
  id         String    @id @default(cuid())
  videoId    String
  nicheId    String
  label      String
  formatId   String?
  reason     String
  confidence String // "alta" | "média" | "baixa"
  model      String
  costUsd    Float?
  status     String    @default("pending")
  chosen     String? // o que eu escolhi no fim (nome do formato ou "nenhum")
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  video  Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  niche  Niche        @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  format VideoFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)

  @@unique([videoId, nicheId])
  @@index([nicheId, status])
}

/// Vídeo estudado escolhido para um formato. Um vídeo entra em no máximo um formato por nicho (para não misturar receitas).
model FormatVideo {
  formatId String
  videoId  String
  nicheId  String
  addedAt  DateTime @default(now())

  format VideoFormat @relation(fields: [formatId], references: [id], onDelete: Cascade)
  video  Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([formatId, videoId])
  @@unique([nicheId, videoId])
}

/// Receita do formato: uma versão por geração. `stats` é medido em código; `content` é a receita escrita pelo Claude.
/// `voice` guarda trechos reais das transcrições (amostra de ritmo de fala para o gerador).
model FormatRecipe {
  id           String   @id @default(cuid())
  formatId     String
  version      Int
  model        String
  stats        String // JSON PlaybookStats + medidas de fala
  content      String // JSON RecipeContent
  markdown     String?
  voice        String   @default("[]") // JSON [{videoId, title, text}]
  videoIds     String   @default("[]") // JSON: Video.id usados
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  format VideoFormat @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@index([formatId, createdAt])
}

/// Regra geral do nicho: só o que é comum a 2+ formatos prontos (gancho, cadência de novidade, fecho, duração).
model NicheRule {
  id           String   @id @default(cuid())
  nicheId      String
  length       String   @default("short") // "short" | "long"
  version      Int
  model        String
  recipeIds    String // JSON: FormatRecipe.id comparadas
  formatNames  String // JSON: nomes dos formatos (para mostrar mesmo se o formato mudar)
  content      String // JSON RuleContent
  markdown     String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([nicheId, length, createdAt])
}

/// Como o MEU canal faz um formato (personagens que entram, motor, bordões, fecho, o que nunca pode).
model ChannelFormat {
  myChannelId String
  formatId    String
  howText     String
  updatedAt   DateTime @updatedAt

  myChannel MyChannel   @relation(fields: [myChannelId], references: [id], onDelete: Cascade)
  format    VideoFormat @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@id([myChannelId, formatId])
}

/// Aprendizado do canal vindo da devolução do Estúdio (roteiro reprovado no filtro de produção).
/// Vale mais que a receita do formato quando os dois conflitam.
model ChannelLesson {
  id          String   @id @default(cuid())
  myChannelId String
  ideaId      String?
  formatId    String?
  text        String
  source      String   @default("devolucao")
  createdAt   DateTime @default(now())

  myChannel MyChannel    @relation(fields: [myChannelId], references: [id], onDelete: Cascade)
  idea      Idea?        @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  format    VideoFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)

  @@index([myChannelId, createdAt])
}

// ---------- Gerador e banco de ideias ----------

/// Status: IDEA | SCRIPT | RETURNED | PRODUCED | PUBLISHED | DISCARDED. Format: short | long (tamanho, não a receita)
model Idea {
  projectCode String?
  currentVersionId String? @unique
  approvedVersionId String? @unique
  approvedAt DateTime?
  currentVersion ScriptVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  approvedVersion ScriptVersion? @relation("ApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  versions ScriptVersion[] @relation("IdeaVersions")
  @@unique([myChannelId, projectCode])
  id               String    @id @default(cuid())
  nicheId          String?
  myChannelId      String?
  format           String
  theme            String
  justification    String?
  titles           String // JSON array de títulos
  chosenTitle      String?
  status           String    @default("IDEA")
  script           String?
  scriptModel      String?
  referenceIds     String? // JSON array de Video.id usados como referência
  structureIds     String? // JSON array de ScriptStructure.id usados no roteiro
  notes            String?
  // Etapa 6
  playbookId       String? // NichePlaybook usada (versão da cartilha)
  ideaData         String? // JSON do Claude: premissa no formato do canal, gancho, adaptação, títulos com fórmula
  scriptData       String? // JSON do roteiro: cenas, falas, texto na tela, checklist conferido
  ideaCostUsd      Float?
  scriptCostUsd    Float?
  // Vídeo do meu canal em que a ideia virou (publicada)
  publishedVideoId String?
  // Formatos: a receita (camada 1) e a regra geral do nicho (camada 2) usadas
  formatId         String?
  recipeId         String?
  ruleId           String?
  // Devolução do Estúdio (roteiro reprovado no filtro de produção)
  returnNotes      String?
  returnedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  niche          Niche?          @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  myChannel      MyChannel?      @relation(fields: [myChannelId], references: [id], onDelete: SetNull)
  myVideos       MyVideo[]
  publishedVideo MyChannelVideo? @relation(fields: [publishedVideoId], references: [id], onDelete: SetNull)
  videoFormat    VideoFormat?    @relation(fields: [formatId], references: [id], onDelete: SetNull)
  lessons        ChannelLesson[]
}

/// Registro bruto de cada chamada ao Claude (auditoria, reaproveitamento e controle de gasto).
model Generation {
  scriptVersionId String?
  scriptVersion ScriptVersion? @relation(fields: [scriptVersionId], references: [id], onDelete: SetNull)
  id           String   @id @default(cuid())
  kind         String // "diagnosis" | "comments" | "ideas" | "script" | "playbook" | ...
  model        String
  videoId      String?
  input        String // JSON
  output       String // JSON
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------- Meus vídeos publicados (feature 8) ----------

model MyVideo {
  id                 String    @id @default(cuid())
  platform           String    @default("youtube")
  externalId         String
  url                String
  myChannelId        String
  title              String?
  thumbnailUrl       String?
  publishedAt        DateTime?
  durationSec        Int?
  isShort            Boolean   @default(false)
  viewCount          Int?
  likeCount          Int?
  commentCount       Int?
  statsFetchedAt     DateTime?
  inspiredVideoId    String?
  inspiredIdeaId     String?
  // Métricas privadas — preenchidas só na versão com OAuth
  ctr                Float?
  impressions        Int?
  avgViewDuration    Float?
  avgViewPercent     Float?
  // Etapa 7
  description        String?
  shortSource        String? // "duration" | "url"
  scriptText         String? // roteiro colado (quando não veio do gerador)
  transcriptText     String?
  transcriptSegments String? // JSON [{start, dur, text}]
  transcriptSource   String? // "youtube" | "manual"
  // YouTube Analytics (login com Google, só leitura). Os números chegam com 1–2 dias de atraso.
  analytics          String? // JSON: views, minutos assistidos, duração média, % médio visto, likes, comentários, compartilhamentos, inscritos
  retention          String? // JSON [{r, watch, rel}] — r = posição no vídeo (0–1)
  trafficSources     String? // JSON [{source, views}]
  dailyViews         String? // JSON [{day, views, minutes}]
  analyticsFetchedAt DateTime?
  analyticsError     String?
  studioNotes        String? // texto livre colado do YouTube Studio
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  myChannel     MyChannel           @relation(fields: [myChannelId], references: [id], onDelete: Cascade)
  inspiredVideo Video?              @relation(fields: [inspiredVideoId], references: [id], onDelete: SetNull)
  inspiredIdea  Idea?               @relation(fields: [inspiredIdeaId], references: [id], onDelete: SetNull)
  snapshots     MyVideoSnapshot[]
  checkpoints   MyVideoCheckpoint[]
  diagnoses     MyVideoDiagnosis[]

  @@unique([platform, externalId])
  @@index([myChannelId, publishedAt])
}

/// Snapshots horários nas primeiras 72h, depois diários.
model MyVideoSnapshot {
  id           Int      @id @default(autoincrement())
  myVideoId    String
  viewCount    Int
  likeCount    Int?
  commentCount Int?
  capturedAt   DateTime @default(now())

  myVideo MyVideo @relation(fields: [myVideoId], references: [id], onDelete: Cascade)

  @@index([myVideoId, capturedAt])
}

/// Números do vídeo em idades fixas (1h, 3h, 24h, 48h).
/// views/likes/comentários vêm da API (com a idade real da medição);
/// "continuaram assistindo" e "% visto" são colados à mão do YouTube Studio até o OAuth.
model MyVideoCheckpoint {
  id              String   @id @default(cuid())
  myVideoId       String
  ageHours        Int // 1 | 3 | 6 | 12 | 24 | 48 | 72 | 168 | 336 | 672
  measuredAgeMin  Int? // idade real em minutos quando a API mediu
  viewCount       Int?
  likeCount       Int?
  commentCount    Int?
  stayedPct       Float? // Shorts: "continuaram assistindo" (%)
  avgViewPct      Float? // % médio do vídeo visto
  avgViewDuration Float? // segundos
  ctr             Float? // taxa de cliques da miniatura (%), colada do Studio
  impressions     Int?
  source          String   @default("api") // api | manual | mixed | analytics (views por dia do Analytics)
  notes           String?
  updatedAt       DateTime @updatedAt

  myVideo MyVideo @relation(fields: [myVideoId], references: [id], onDelete: Cascade)

  @@unique([myVideoId, ageHours])
}

/// Diagnóstico de um vídeo meu numa idade (ex.: 24h, 3 dias). Um vídeo pode ter vários: dá para ver a leitura mudar.
/// `inputs` guarda os números usados (medidos em código); `content` é a leitura do Claude (hipóteses).
model MyVideoDiagnosis {
  id           String   @id @default(cuid())
  myVideoId    String
  ageHours     Float
  milestone    Int? // 24 | 72 | 168 quando automático
  trigger      String // "auto" | "manual"
  model        String
  inputs       String // JSON
  content      String // JSON
  markdown     String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  myVideo MyVideo @relation(fields: [myVideoId], references: [id], onDelete: Cascade)

  @@index([myVideoId, createdAt])
}

/// Diagnóstico do canal inteiro: o que funciona e o que não funciona nos MEUS vídeos.
/// As lições vão para o gerador (aprendizados dos meus vídeos).
model MyChannelReport {
  id           String   @id @default(cuid())
  myChannelId  String
  trigger      String // "auto" | "manual"
  model        String
  inputs       String // JSON
  content      String // JSON
  markdown     String?
  videoCount   Int
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  myChannel MyChannel @relation(fields: [myChannelId], references: [id], onDelete: Cascade)

  @@index([myChannelId, createdAt])
}

/// Login com Google (só leitura) de um canal do YouTube. Fica só no banco local.
/// status: "ok" | "expired" (precisa entrar de novo)
model GoogleAuth {
  id                String   @id @default(cuid())
  channelExternalId String   @unique
  channelTitle      String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime
  scope             String
  status            String   @default("ok")
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------- Tarefas em segundo plano ----------

/// Chamadas demoradas ao Claude (diagnóstico, comentários, cartilha, ideias, roteiro) rodam em segundo plano:
/// o botão cria a tarefa e volta na hora, e o app avisa quando termina. status: running | ok | error
model Job {
  id          String    @id @default(cuid())
  kind        String // "diagnosis" | "comments" | "playbook" | "ideas" | "script"
  targetId    String // vídeo, nicho:formato, canal ou ideia
  label       String // texto para o aviso (ex.: "Diagnóstico: título do vídeo")
  href        String // onde ver o resultado
  status      String    @default("running")
  message     String?
  progress    Int? // 0-100 quando dá para medir (etapas, palavras-chave); senão o aviso estima pelo tempo
  step        String? // etapa atual (ex.: "Diagnóstico (2 de 3)")
  expectedSec Int? // duração típica, para estimar a barra de progresso
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status])
  @@index([kind, targetId])
}

/// Immutable snapshots; restoration appends a new version. Approval belongs to Idea.
model ScriptVersion {
 direction DirectionRun?
 id String @id @default(cuid())
 ideaId String
 number Int
 baseVersionId String?
 content String
 markdown String
 request String?
 category String
 origin String
 author String
 createdAt DateTime @default(now())
 idea Idea @relation("IdeaVersions", fields: [ideaId], references: [id], onDelete: Restrict)
 baseVersion ScriptVersion? @relation("VersionBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
 descendants ScriptVersion[] @relation("VersionBase")
 currentFor Idea? @relation("CurrentVersion")
 approvedFor Idea? @relation("ApprovedVersion")
 generations Generation[]
 @@unique([ideaId, number])
}

/// Direction metadata never changes the approved script snapshot.
model DirectionRun {
 approvedAt DateTime?
 id String @id @default(cuid())
 versionId String @unique
 version ScriptVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
 sourceHash String
 study String
 reference String
 scene String?
 photography String?
 sound String?
 integration String?
 runningStage String?
 error String?
 costUsd Float @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
